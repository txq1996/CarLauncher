<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52px"
    android:background="@drawable/bg_grid_line"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8px">

    <ImageView
        android:id="@+id/app_icon"
        android:layout_width="36px"
        android:layout_height="36px"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/app_label"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10px"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/foreground"
        android:textSize="19px" />

    <CheckBox
        android:id="@+id/item_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/foreground"
        android:minWidth="0px"
        android:minHeight="0px"
        android:padding="8px" />

    <Button
        android:id="@+id/btn_up"
        android:layout_width="48px"
        android:layout_height="44px"
        android:layout_marginStart="12px"
        android:text="▲"
        android:textSize="16px"
        android:padding="0px"
        android:minWidth="0px"
        android:minHeight="0px"
        android:insetTop="0px"
        android:insetBottom="0px" />

    <Button
        android:id="@+id/btn_down"
        android:layout_width="48px"
        android:layout_height="44px"
        android:layout_marginStart="6px"
        android:text="▼"
        android:textSize="16px"
        android:padding="0px"
        android:minWidth="0px"
        android:minHeight="0px"
        android:insetTop="0px"
        android:insetBottom="0px" />
</LinearLayout>
