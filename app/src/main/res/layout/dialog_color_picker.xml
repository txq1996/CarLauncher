<?xml version="1.0" encoding="utf-8"?>
<!-- 颜色选择器对话框：1280x720 车机 10 寸屏优化（大触控目标） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="32px">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 日/夜切换：大按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_tab_day"
                android:layout_width="0px"
                android:layout_height="56px"
                android:layout_weight="1"
                android:text="日间"
                android:textSize="22px"
                android:minHeight="0px"
                android:padding="0px" />

            <Button
                android:id="@+id/btn_tab_night"
                android:layout_width="0px"
                android:layout_height="56px"
                android:layout_weight="1"
                android:layout_marginStart="12px"
                android:text="夜间"
                android:textSize="22px"
                android:minHeight="0px"
                android:padding="0px" />
        </LinearLayout>

        <!-- 自动采样开关：大字大勾选 -->
        <CheckBox
            android:id="@+id/cb_auto"
            android:layout_width="match_parent"
            android:layout_height="56px"
            android:layout_marginTop="16px"
            android:text="自动采样（从图标提取底色）"
            android:textColor="@color/foreground"
            android:textSize="20px"
            android:buttonTint="@color/foreground"
            android:gravity="center_vertical" />

        <!-- 颜色预览：大色条 -->
        <View
            android:id="@+id/color_preview"
            android:layout_width="match_parent"
            android:layout_height="64px"
            android:layout_marginTop="16px" />

        <!-- RGB 滑条：大行高易触控 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20px"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56px"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="32px"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="R"
                    android:textColor="@color/trafficRed"
                    android:textSize="24px" />

                <SeekBar
                    android:id="@+id/seek_r"
                    android:layout_width="0px"
                    android:layout_height="56px"
                    android:layout_weight="1"
                    android:layout_marginStart="12px"
                    android:max="255"
                    android:progressTint="@color/trafficRed" />

                <TextView
                    android:id="@+id/tv_r"
                    android:layout_width="48px"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0"
                    android:textColor="@color/foreground_secondary"
                    android:textSize="18px" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56px"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="32px"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="G"
                    android:textColor="@color/trafficGreen"
                    android:textSize="24px" />

                <SeekBar
                    android:id="@+id/seek_g"
                    android:layout_width="0px"
                    android:layout_height="56px"
                    android:layout_weight="1"
                    android:layout_marginStart="12px"
                    android:max="255"
                    android:progressTint="@color/trafficGreen" />

                <TextView
                    android:id="@+id/tv_g"
                    android:layout_width="48px"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0"
                    android:textColor="@color/foreground_secondary"
                    android:textSize="18px" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56px"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="32px"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="B"
                    android:textColor="@color/trafficYellow"
                    android:textSize="24px" />

                <SeekBar
                    android:id="@+id/seek_b"
                    android:layout_width="0px"
                    android:layout_height="56px"
                    android:layout_weight="1"
                    android:layout_marginStart="12px"
                    android:max="255"
                    android:progressTint="@color/trafficYellow" />

                <TextView
                    android:id="@+id/tv_b"
                    android:layout_width="48px"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0"
                    android:textColor="@color/foreground_secondary"
                    android:textSize="18px" />
            </LinearLayout>
        </LinearLayout>

        <!-- 预设色块标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20px"
            android:text="预设颜色"
            android:textColor="@color/foreground_secondary"
            android:textSize="18px" />

        <!-- 64 色预设网格：8 列无间距 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid_presets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8px"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />
    </LinearLayout>
</ScrollView>
