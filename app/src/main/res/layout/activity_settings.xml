<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16px">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="桌面设置"
            android:textColor="@color/foreground"
            android:textSize="24px"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_restart_launcher"
            android:layout_width="wrap_content"
            android:layout_height="48px"
            android:minWidth="0px"
            android:paddingStart="16px"
            android:paddingEnd="16px"
            android:text="重启桌面"
            android:textColor="@color/foreground"
            android:textSize="18px" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_marginTop="20px"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tab_box"
                android:layout_width="140px"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tab_layout"
                            android:layout_width="match_parent"
                            android:layout_height="60px"
                            android:gravity="center"
                            android:text="布局"
                            android:textSize="23px" />

                        <TextView
                            android:id="@+id/tab_speed"
                            android:layout_width="match_parent"
                            android:layout_height="60px"
                            android:gravity="center"
                            android:text="车速"
                            android:textSize="23px" />

                        <TextView
                            android:id="@+id/tab_music"
                            android:layout_width="match_parent"
                            android:layout_height="60px"
                            android:gravity="center"
                            android:text="音乐"
                            android:textSize="23px" />

                        <TextView
                            android:id="@+id/tab_general"
                            android:layout_width="match_parent"
                            android:layout_height="60px"
                            android:gravity="center"
                            android:text="通用"
                            android:textSize="23px" />

                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <FrameLayout
                android:layout_width="0px"
                android:layout_height="match_parent"
                android:layout_marginStart="24px"
                android:layout_weight="1">

                <!-- ── 布局 ───────────────────────────── -->
                <ScrollView
                    android:id="@+id/panel_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="页面与卡片（px，滑条左右拉）"
                            android:textColor="@color/foreground"
                            android:textSize="23px"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/box_layout_seeks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8px"
                            android:orientation="vertical" />
                    </LinearLayout>
                </ScrollView>

                <!-- ── 车速 ───────────────────────────── -->
                <ScrollView
                    android:id="@+id/panel_speed"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_grid_line"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8px"
                            android:paddingEnd="8px"
                            android:paddingTop="8px"
                            android:paddingBottom="8px">

                            <TextView
                                android:layout_width="0px"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="名称"
                                android:textColor="@color/foreground_secondary"
                                android:textSize="14px" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="显"
                                android:textColor="@color/foreground_secondary"
                                android:textSize="14px"
                                android:paddingStart="8px"
                                android:paddingEnd="8px" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12px"
                                android:text="字号"
                                android:textColor="@color/foreground_secondary"
                                android:textSize="14px" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24px"
                                android:text="顺序"
                                android:textColor="@color/foreground_secondary"
                                android:textSize="14px" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/box_all_settings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8px"
                            android:orientation="vertical" />
                    </LinearLayout>
                </ScrollView>

                <!-- ── 音乐 ───────────────────────────── -->
                <ScrollView
                    android:id="@+id/panel_music"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="字号（px）"
                            android:textColor="@color/foreground"
                            android:textSize="23px"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/box_music_seeks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8px"
                            android:orientation="vertical" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24px"
                            android:text="显示内容"
                            android:textColor="@color/foreground"
                            android:textSize="23px"
                            android:textStyle="bold" />

                        <CheckBox
                            android:id="@+id/cb_music_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="52px"
                            android:text="歌曲名"
                            android:textColor="@color/foreground"
                            android:textSize="21px" />

                        <CheckBox
                            android:id="@+id/cb_music_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="52px"
                            android:text="歌手名"
                            android:textColor="@color/foreground"
                            android:textSize="21px" />

                        <CheckBox
                            android:id="@+id/cb_music_time"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="52px"
                            android:text="进度时间（当前/总时长）"
                            android:textColor="@color/foreground"
                            android:textSize="21px" />

                        <CheckBox
                            android:id="@+id/cb_music_bar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="52px"
                            android:text="进度条"
                            android:textColor="@color/foreground"
                            android:textSize="21px" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="40px"
                            android:layout_marginTop="12px"
                            android:text="全部关闭时音乐卡仅保留播放控制按钮"
                            android:textColor="@color/foreground_secondary"
                            android:textSize="15px" />
                    </LinearLayout>
                </ScrollView>

                <!-- ── 通用（在线更新）───────────────────── -->
                <ScrollView
                    android:id="@+id/panel_general"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ADB 调试入口"
                            android:textColor="@color/foreground"
                            android:textSize="23px"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_adb_debug_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8px"
                            android:text="不支持 debug"
                            android:textColor="@color/foreground_secondary"
                            android:textSize="17px" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24px"
                            android:text="在线更新"
                            android:textColor="@color/foreground"
                            android:textSize="23px"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_update_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8px"
                            android:text="未检查"
                            android:textColor="@color/foreground_secondary"
                            android:textSize="17px" />

                        <TextView
                            android:id="@+id/tv_version_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16px"
                            android:text="当前版本：--"
                            android:textColor="@color/foreground_secondary"
                            android:textSize="15px" />

                        <Button
                            android:id="@+id/btn_check_update"
                            android:layout_width="match_parent"
                            android:layout_height="60px"
                            android:layout_marginTop="16px"
                            android:text="检查更新"
                            android:textColor="@color/foreground"
                            android:textSize="21px" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16px"
                            android:text="从 GitHub Releases 拉取最新版本，发现新版本时自动下载并弹出系统安装器"
                            android:textColor="@color/foreground_secondary"
                            android:textSize="15px" />
                    </LinearLayout>
                </ScrollView>

            </FrameLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:paddingStart="4px"
            android:paddingBottom="4px"
            android:text="尺寸单位均为 px"
            android:textColor="@color/foreground_secondary"
            android:textSize="15px" />
    </FrameLayout>
</LinearLayout>
