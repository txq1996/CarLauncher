<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16px">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="桌面设置"
            android:textColor="@color/foreground"
            android:textSize="24px"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_restart_launcher"
            android:layout_width="wrap_content"
            android:layout_height="56px"
            android:minWidth="0px"
            android:paddingStart="20px"
            android:paddingEnd="20px"
            android:text="重启桌面"
            android:textColor="@color/foreground"
            android:textSize="18px" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_marginTop="20px"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- ── 左侧 Tab 栏 ── -->
            <LinearLayout
                android:id="@+id/tab_box"
                android:layout_width="140px"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView android:id="@+id/tab_layout" style="@style/Tab" android:text="布局" />
                        <TextView android:id="@+id/tab_time" style="@style/Tab" android:text="时间" />
                        <TextView android:id="@+id/tab_speed" style="@style/Tab" android:text="车速" />
                        <TextView android:id="@+id/tab_music" style="@style/Tab" android:text="音乐" />
                        <TextView android:id="@+id/tab_dock" style="@style/Tab" android:text="底栏" />
                        <TextView android:id="@+id/tab_apps" style="@style/Tab" android:text="应用" />
                        <TextView android:id="@+id/tab_general" style="@style/Tab" android:text="通用" />
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <FrameLayout
                android:layout_width="0px"
                android:layout_height="match_parent"
                android:layout_marginStart="24px"
                android:layout_weight="1">

                <!-- ── 布局 ── -->
                <ScrollView android:id="@+id/panel_layout" style="@style/Panel" android:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView style="@style/SectionHeader" android:text="布局参数" />
                        <LinearLayout android:id="@+id/box_layout_seeks" style="@style/SeekBox" />

                        <TextView style="@style/SectionHeader" android:layout_marginTop="24px" android:text="卡片显示" />
                        <CheckBox android:id="@+id/cb_hide_status_bar" style="@style/CheckRow" android:text="显示状态栏" />
                        <CheckBox android:id="@+id/cb_show_time" style="@style/CheckRow" android:text="显示时间卡片" />
                        <CheckBox android:id="@+id/cb_show_speed_card" style="@style/CheckRow" android:text="显示车速卡片" />
                        <CheckBox android:id="@+id/cb_show_music_card" style="@style/CheckRow" android:text="显示音乐卡片" />
                        <CheckBox android:id="@+id/cb_show_dock" style="@style/CheckRow" android:text="显示底栏" />
                    </LinearLayout>
                </ScrollView>

                <!-- ── 时间 ── -->
                <ScrollView android:id="@+id/panel_time" style="@style/Panel">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView style="@style/SectionHeader" android:text="字体大小" />
                        <LinearLayout android:id="@+id/box_time_seeks" style="@style/SeekBox" />

                        <TextView
                            android:id="@+id/tv_time_format"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_grid_line"
                            android:minHeight="52px"
                            android:gravity="center_vertical"
                            android:padding="8px"
                            android:text="时间格式：HH:mm:ss"
                            android:textColor="@color/foreground"
                            android:textSize="19px" />
                    </LinearLayout>
                </ScrollView>

                <!-- ── 车速 ── -->
                <ScrollView android:id="@+id/panel_speed" style="@style/Panel">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_grid_line"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="8px">

                            <TextView
                                android:layout_width="0px"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="名称"
                                android:textColor="@color/foreground_secondary"
                                android:textSize="15px" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="显示"
                                android:textColor="@color/foreground_secondary"
                                android:textSize="15px"
                                android:paddingStart="8px"
                                android:paddingEnd="8px" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12px"
                                android:text="字号(px)"
                                android:textColor="@color/foreground_secondary"
                                android:textSize="15px" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24px"
                                android:text="排序"
                                android:textColor="@color/foreground_secondary"
                                android:textSize="15px" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/box_all_settings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8px"
                            android:orientation="vertical" />
                    </LinearLayout>
                </ScrollView>

                <!-- ── 音乐 ── -->
                <ScrollView android:id="@+id/panel_music" style="@style/Panel">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView style="@style/SectionHeader" android:text="绑定应用" />

                        <LinearLayout
                            android:id="@+id/row_music_app"
                            android:layout_width="match_parent"
                            android:layout_height="52px"
                            android:layout_marginTop="8px"
                            android:background="@drawable/bg_grid_line"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="8px">

                            <ImageView
                                android:id="@+id/iv_music_app_icon"
                                android:layout_width="32px"
                                android:layout_height="32px"
                                android:scaleType="fitCenter" />
                            <TextView
                                android:id="@+id/tv_music_app_name"
                                android:layout_width="0px"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10px"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="未绑定"
                                android:textColor="@color/foreground"
                                android:textSize="17px" />
                            <Button
                                android:id="@+id/btn_pick_music_app"
                                android:layout_width="wrap_content"
                                android:layout_height="36px"
                                android:layout_marginStart="8px"
                                android:minWidth="72px"
                                android:paddingStart="12px"
                                android:paddingEnd="12px"
                                android:text="选择"
                                android:textColor="@color/foreground"
                                android:textSize="15px" />
                        </LinearLayout>

                        <TextView style="@style/SectionHeader" android:layout_marginTop="24px" android:text="字体大小 (px)" />
                        <LinearLayout android:id="@+id/box_music_seeks" style="@style/SeekBox" />

                        <TextView style="@style/SectionHeader" android:layout_marginTop="24px" android:text="显示项" />
                        <CheckBox android:id="@+id/cb_music_title" style="@style/CheckRow" android:text="歌曲名" />
                        <CheckBox android:id="@+id/cb_music_artist" style="@style/CheckRow" android:text="歌手名" />
                        <CheckBox android:id="@+id/cb_music_time" style="@style/CheckRow" android:text="进度时间（当前/总时长）" />
                        <CheckBox android:id="@+id/cb_music_bar" style="@style/CheckRow" android:text="进度条" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="40px"
                            android:layout_marginTop="12px"
                            android:text="全部关闭后，音乐卡仅保留播放按钮"
                            android:textColor="@color/foreground_secondary"
                            android:textSize="15px" />
                    </LinearLayout>
                </ScrollView>

                <!-- ── 底栏 ── -->
                <ScrollView android:id="@+id/panel_dock" style="@style/Panel">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <CheckBox android:id="@+id/cb_show_dock_label" style="@style/CheckRow" android:text="显示图标名称" />
                        <LinearLayout android:id="@+id/box_dock_seeks" style="@style/SeekBox" />
                    </LinearLayout>
                </ScrollView>

                <!-- ── 应用（抽屉排序与隐藏） ── -->
                <ScrollView android:id="@+id/panel_apps" style="@style/Panel">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView style="@style/SectionHeader" android:text="全部应用" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_grid_line"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="8px">

                            <TextView
                                android:layout_width="0px"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="名称"
                                android:textColor="@color/foreground_secondary"
                                android:textSize="15px" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="隐藏"
                                android:textColor="@color/foreground_secondary"
                                android:textSize="15px"
                                android:paddingStart="8px"
                                android:paddingEnd="8px" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24px"
                                android:text="排序"
                                android:textColor="@color/foreground_secondary"
                                android:textSize="15px" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/box_apps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8px"
                            android:orientation="vertical" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="40px"
                            android:layout_marginTop="12px"
                            android:text="排序和隐藏在下次打开抽屉时生效，无需重启桌面；隐藏的应用仍可添加到底栏和分屏"
                            android:textColor="@color/foreground_secondary"
                            android:textSize="15px" />

                        <TextView style="@style/SectionHeader" android:text="全部应用外观" />

                        <LinearLayout
                            android:id="@+id/box_drawer_seeks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="40px"
                            android:layout_marginTop="12px"
                            android:text="设置抽屉与悬浮窗的图标大小、间距、字体大小，下次打开时生效"
                            android:textColor="@color/foreground_secondary"
                            android:textSize="15px" />
                    </LinearLayout>
                </ScrollView>

                <!-- ── 通用 ── -->
                <ScrollView android:id="@+id/panel_general" style="@style/Panel">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView style="@style/SectionHeader" android:text="通用设置" />
                        <CheckBox
                            android:id="@+id/cb_home_direct_drawer"
                            style="@style/CheckRow"
                            android:layout_marginTop="8px"
                            android:text="启动直接打开全部应用" />

                        <TextView style="@style/SectionHeader" android:layout_marginTop="24px" android:text="在线更新" />
                        <TextView
                            android:id="@+id/tv_update_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8px"
                            android:text="未检查"
                            android:textColor="@color/foreground_secondary"
                            android:textSize="17px" />
                        <TextView
                            android:id="@+id/tv_version_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16px"
                            android:text="当前版本：--"
                            android:textColor="@color/foreground_secondary"
                            android:textSize="15px" />
                        <Button
                            android:id="@+id/btn_check_update"
                            android:layout_width="match_parent"
                            android:layout_height="60px"
                            android:layout_marginTop="16px"
                            android:text="检查更新"
                            android:textColor="@color/foreground"
                            android:textSize="21px" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16px"
                            android:text="从 GitHub Releases 拉取最新版本，发现新版本时自动下载并弹出系统安装器"
                            android:textColor="@color/foreground_secondary"
                            android:textSize="15px" />
                    </LinearLayout>
                </ScrollView>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
