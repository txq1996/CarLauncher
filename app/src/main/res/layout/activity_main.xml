<?xml version="1.0" encoding="utf-8"?>
<!-- 主页 = 单页 Widget 画布：widget_container 绝对定位放置 Widget；
     design_toolbar 悬浮顶层仅设计模式显示（不占画布高度，保证设计/普通坐标一致）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <FrameLayout
        android:id="@+id/widget_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 悬浮设计工具栏：仅设计模式显示；单行、60px 高、半透明；
         按钮为圆角胶囊（bg_design_btn），上下留边、间距 6px。 -->
    <LinearLayout
        android:id="@+id/design_toolbar"
        android:layout_width="match_parent"
        android:layout_height="60px"
        android:layout_gravity="top"
        android:background="#66000000"
        android:elevation="8px"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8px"
        android:paddingEnd="8px"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_design_add"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0px"
            android:layout_height="44px"
            android:layout_marginStart="3px"
            android:layout_marginEnd="3px"
            android:layout_weight="1"
            android:background="@drawable/bg_design_btn"
            android:text="添加"
            android:textColor="@android:color/white"
            android:textSize="16px" />

        <Button
            android:id="@+id/btn_design_del"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0px"
            android:layout_height="44px"
            android:layout_marginStart="3px"
            android:layout_marginEnd="3px"
            android:layout_weight="1"
            android:background="@drawable/bg_design_btn"
            android:text="删除"
            android:textColor="@android:color/white"
            android:textSize="16px" />

        <Button
            android:id="@+id/btn_design_props"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0px"
            android:layout_height="44px"
            android:layout_marginStart="3px"
            android:layout_marginEnd="3px"
            android:layout_weight="1"
            android:background="@drawable/bg_design_btn"
            android:text="属性"
            android:textColor="@android:color/white"
            android:textSize="16px" />

        <Button
            android:id="@+id/btn_design_status"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0px"
            android:layout_height="44px"
            android:layout_marginStart="3px"
            android:layout_marginEnd="3px"
            android:layout_weight="1"
            android:background="@drawable/bg_design_btn"
            android:text="状态栏"
            android:textColor="@android:color/white"
            android:textSize="16px" />

        <Button
            android:id="@+id/btn_design_open"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0px"
            android:layout_height="44px"
            android:layout_marginStart="3px"
            android:layout_marginEnd="3px"
            android:layout_weight="1"
            android:background="@drawable/bg_design_btn"
            android:text="打开"
            android:textColor="@android:color/white"
            android:textSize="16px" />

        <Button
            android:id="@+id/btn_design_reset"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0px"
            android:layout_height="44px"
            android:layout_marginStart="3px"
            android:layout_marginEnd="3px"
            android:layout_weight="1"
            android:background="@drawable/bg_design_btn"
            android:text="重置"
            android:textColor="@android:color/white"
            android:textSize="16px" />

        <Button
            android:id="@+id/btn_design_save"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0px"
            android:layout_height="44px"
            android:layout_marginStart="3px"
            android:layout_marginEnd="3px"
            android:layout_weight="1"
            android:background="@drawable/bg_design_btn"
            android:text="另存为"
            android:textColor="@android:color/white"
            android:textSize="16px" />

        <Button
            android:id="@+id/btn_design_done"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0px"
            android:layout_height="44px"
            android:layout_marginStart="3px"
            android:layout_marginEnd="3px"
            android:layout_weight="1"
            android:background="@drawable/bg_design_btn"
            android:text="退出"
            android:textColor="@android:color/white"
            android:textSize="16px" />
    </LinearLayout>
</FrameLayout>
