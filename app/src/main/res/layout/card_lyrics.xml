<?xml version="1.0" encoding="utf-8"?>
<!-- 歌词模块卡：右栏容器第一个模块。
     结构：歌曲信息（歌名/作者，点击绑定或唤醒音乐app）/ 专辑封面（有封面时显示）/
     歌词区（动态行数+双语）/ 时间+进度条 / 播放控制按钮（底部）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_lyrics"
    android:layout_width="match_parent"
    android:layout_height="0px"
    android:layout_weight="1"
    android:orientation="vertical"
    android:padding="12px">

    <!-- 歌曲信息区：点击唤醒已绑定音乐app（未绑定先选择），长按重新绑定 -->
    <LinearLayout
        android:id="@+id/box_lyrics_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_lyrics_track"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="未在播放"
            android:textColor="@color/foreground"
            android:textSize="20px"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_lyrics_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4px"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/foreground_tertiary"
            android:textSize="14px" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_lyrics_cover"
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_weight="1.2"
        android:layout_marginTop="8px"
        android:scaleType="centerCrop"
        android:contentDescription="专辑封面"
        android:visibility="gone" />

    <!-- 歌词区：行数动态（CFG_LINES），当前句高亮 + 翻译副行 -->
    <LinearLayout
        android:id="@+id/box_lyrics_lines"
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_weight="2"
        android:gravity="center"
        android:orientation="vertical" />

    <!-- 时间 + 进度条 -->
    <RelativeLayout
        android:id="@+id/box_lyrics_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6px">

        <TextView
            android:id="@+id/lyrics_cur_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="00:00"
            android:textColor="@color/foreground_tertiary"
            android:textSize="14px" />

        <TextView
            android:id="@+id/lyrics_total_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="00:00"
            android:textColor="@color/foreground_tertiary"
            android:textSize="14px" />
    </RelativeLayout>

    <ProgressBar
        android:id="@+id/lyrics_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6px"
        android:layout_marginTop="4px"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/progress_music" />

    <!-- 播放控制（与左侧音乐卡同款按钮，置底） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8px"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_lyrics_prev"
            android:layout_width="44px"
            android:layout_height="44px"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="上一曲"
            android:padding="11px"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_prev" />

        <ImageButton
            android:id="@+id/btn_lyrics_play"
            android:layout_width="56px"
            android:layout_height="56px"
            android:layout_marginLeft="10px"
            android:layout_marginRight="10px"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="播放/暂停"
            android:padding="13px"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pause" />

        <ImageButton
            android:id="@+id/btn_lyrics_next"
            android:layout_width="44px"
            android:layout_height="44px"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="下一曲"
            android:padding="11px"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_next" />
    </LinearLayout>
</LinearLayout>
