<?xml version="1.0" encoding="utf-8"?>
<!-- 车速卡：所有内容合并到一个容器，整体水平垂直居中。
     导航/巡航区（navi_panel）：由 SpeedDelegate + NaviPanelDelegate 动态 removeAllViews + addView，
     行序/字号/显隐由 SettingsSnapshot 驱动。 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_speed"
    android:layout_width="match_parent"
    android:layout_height="0px"
    android:layout_weight="1">

    <LinearLayout
        android:id="@+id/speed_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/navi_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 转向行：转向图标 + 距离 -->
            <LinearLayout
                android:id="@+id/navi_row_turn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_turn_icon"
                    android:layout_width="48px"
                    android:layout_height="48px"
                    android:scaleType="fitCenter"
                    android:src="@drawable/navinfo_icon9" />

                <TextView
                    android:id="@+id/tv_navi_dist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12px"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/foreground"
                    android:textSize="36px"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 路名（26px） -->
            <TextView
                android:id="@+id/tv_navi_road"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4px"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/foreground"
                android:textSize="26px"
                android:textStyle="bold" />

            <!-- 终点名称（17px secondary） -->
            <TextView
                android:id="@+id/tv_navi_dest"
                style="@style/NaviHint"
                android:textColor="@color/foreground_secondary" />

            <!-- 以下 5 个均为 hint 层级（17px tertiary），共用 @style/NaviHint -->
            <TextView android:id="@+id/tv_navi_eta_text" style="@style/NaviHint" />
            <TextView android:id="@+id/tv_navi_light_count" style="@style/NaviHint" />
            <TextView android:id="@+id/tv_navi_exit" style="@style/NaviHint" />
            <TextView android:id="@+id/tv_navi_direction" style="@style/NaviHint" />

            <!-- 剩余距离和时间行 -->
            <LinearLayout
                android:id="@+id/navi_row_eta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3px"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_navi_remain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/foreground_tertiary"
                    android:textSize="17px" />
                <TextView
                    android:id="@+id/tv_navi_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14px"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/foreground_tertiary"
                    android:textSize="17px" />
            </LinearLayout>

            <TextView android:id="@+id/tv_navi_alert" style="@style/NaviHint" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
