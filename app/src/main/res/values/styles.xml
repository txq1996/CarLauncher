<resources>

    <!-- ═══ 设置页共享样式 ═══ -->

    <!-- Tab 按钮（布局/应用/通用） -->
    <style name="Tab">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60px</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">23px</item>
    </style>

    <!-- 设置面板 ScrollView（除首个外都 visibility=gone） -->
    <style name="Panel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:fillViewport">true</item>
        <item name="android:scrollbars">none</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- CheckBox 行（与全部应用行同风格：64px 圆角卡片）：名称居左、勾选框居右 -->
    <style name="CheckRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64px</item>
        <item name="android:layout_marginTop">6px</item>
        <item name="android:background">@drawable/bg_app_order_row</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16px</item>
        <item name="android:paddingEnd">16px</item>
    </style>

    <style name="CheckRowLabel">
        <item name="android:layout_width">0px</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:textSize">20px</item>
    </style>

    <style name="CheckRowCheck">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0px</item>
        <item name="android:minHeight">0px</item>
        <item name="android:button">@drawable/checkbox_px</item>
    </style>

    <!-- 通用按钮样式（ThemeButton）：56px 高、18px 字、水平 20px 内边距、bg_btn 背景（surface_variant 常态 / surface_highlight 按压）、foreground 文字色、无圆角无阴影
         使用位置：
         - activity_settings.xml 中 btn_check_update（检查更新按钮）
         - SettingsActivity.actionButton()（布局行：设默认/删除/重命名/复制/属性/设计器）
         - SettingsActivity.dialogButton()（对话框：取消/确认/删除等）
         - UpdateDelegate.label()（更新确认对话框：稍后/立即更新） -->
    <style name="ThemeButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">56px</item>
        <item name="android:minWidth">0px</item>
        <item name="android:minHeight">0px</item>
        <item name="android:paddingStart">20px</item>
        <item name="android:paddingEnd">20px</item>
        <item name="android:background">@drawable/bg_btn</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:textSize">18px</item>
    </style>

    <!-- ═══ 导航面板共享样式 ═══ -->

    <!-- 导航 hint 行（eta_text/light_count/exit/direction/alert） -->
    <style name="NaviHint">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3px</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/foreground_tertiary</item>
        <item name="android:textSize">17px</item>
    </style>

</resources>
