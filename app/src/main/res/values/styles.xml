<resources>

    <!-- ═══ 设置页共享样式 ═══ -->

    <!-- Tab 按钮（布局/时间/车速/音乐/底栏/通用） -->
    <style name="Tab">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60px</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">23px</item>
    </style>

    <!-- 设置面板 ScrollView（除首个外都 visibility=gone） -->
    <style name="Panel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:fillViewport">true</item>
        <item name="android:scrollbars">none</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- 分节标题（"布局参数"/"卡片显示"/"字体大小" 等） -->
    <style name="SectionHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:textSize">23px</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- CheckBox 行（与全部应用行同风格：64px 圆角卡片）：名称居左、勾选框居右 -->
    <style name="CheckRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64px</item>
        <item name="android:layout_marginTop">6px</item>
        <item name="android:background">@drawable/bg_app_order_row</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16px</item>
        <item name="android:paddingEnd">16px</item>
    </style>

    <style name="CheckRowLabel">
        <item name="android:layout_width">0px</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:textSize">20px</item>
    </style>

    <style name="CheckRowCheck">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:buttonTint">@color/foreground</item>
    </style>

    <!-- 设置面板子容器（box_*_seeks 等） -->
    <style name="SeekBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8px</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- ═══ 导航面板共享样式 ═══ -->

    <!-- 导航 hint 行（eta_text/light_count/exit/direction/alert） -->
    <style name="NaviHint">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3px</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/foreground_tertiary</item>
        <item name="android:textSize">17px</item>
    </style>

    <!-- ═══ 抽屉/底栏格子共享样式 ═══ -->

    <!-- 图标 + 标签的垂直格子（抽屉/底栏通用） -->
    <style name="CellIcon">
        <item name="android:scaleType">centerInside</item>
    </style>

    <style name="CellLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/foreground</item>
    </style>

</resources>
