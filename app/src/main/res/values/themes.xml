<resources>
    <style name="Theme.Launcher37" parent="android:Theme.Material.Light.NoActionBar">
        <!-- 窗口与状态栏 -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/background</item>

        <!--
            framework 原生 Material 属性映射到 A_深灰蓝 palette：
            - colorPrimary = foreground_secondary（中性主色）
            - colorAccent = foreground_secondary
            - colorError = trafficRed（错误/超速与红绿灯同色）
            - colorBackground / windowBackground = background
            - colorControlNormal / Activated / Highlight = foreground / foreground_secondary / surface_highlight
            layout 内直接 @color/* 引用 palette token。
        -->
        <item name="android:colorPrimary">@color/foreground_secondary</item>
        <item name="android:colorPrimaryDark">@color/foreground_secondary</item>
        <item name="android:colorSecondary">@color/foreground_tertiary</item>
        <item name="android:colorAccent">@color/foreground_secondary</item>
        <item name="android:colorError">@color/trafficRed</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:colorControlNormal">@color/foreground</item>
        <item name="android:colorControlActivated">@color/foreground_secondary</item>
        <item name="android:colorControlHighlight">@color/surface_highlight</item>
    </style>
</resources>