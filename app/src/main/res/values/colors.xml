<resources>

	<!-- 页面背景：整个 Launcher 的最底层背景 -->
	<color name="background">#F7F8FA</color>

	<!-- 一级容器：卡片、按钮、普通组件 -->
	<color name="surface">#DEE2E7</color>

	<!-- 二级容器：输入框、进度条底、特殊组件、次级区域 -->
	<color name="surface_variant">#C0C6CD</color>

	<!-- 交互状态：Pressed、Selected、Focused、对话框等强调区域 -->
        <color name="surface_highlight">#ADB4BC</color>

	<!-- 一级内容：标题、正文、主要文字、主要 Icon -->
	<color name="foreground">#121820</color>

	<!-- 二级内容：副标题、单位、辅助信息、次要文字 -->
	<color name="foreground_secondary">#424D59</color>

	<!-- 三级内容：弱辅助信息、次要提示、低优先级文字 -->
	<color name="foreground_tertiary">#68737F</color>

	<!-- 结构边界：分割线、边框、描边 -->
        <color name="divider">#99A1AA</color>

    <!-- 红绿灯（固定视觉语言，不随日/夜切换） -->
    <color name="trafficRed">#FFFF5252</color>
    <color name="trafficYellow">#FFFFD740</color>
    <color name="trafficGreen">#FF69F0AE</color>

</resources>