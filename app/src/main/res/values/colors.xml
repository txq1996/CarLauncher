<!--
    调色板：A_深灰蓝（浅色模式 / values/）
    来源：out/car_launcher_color_palettes/A_深灰蓝/res/values/colors.xml
    8 个核心 token 直接对应 palette 命名：
      background / surface / surface_variant / surface_highlight
      foreground / foreground_secondary / foreground_tertiary
      divider
    另保留：trafficRed / trafficYellow / trafficGreen（红绿灯语义固定，不随主题变）。
    其它 M3 token（primary / secondary / error / outline 等）已删除——
    layout / drawable / themes 中按组件语义直接引用 8 色。
-->
<resources>

    <!-- 页面背景 -->
    <color name="background">#F5F7FA</color>

    <!-- 卡片 / 按钮 / 普通组件 -->
    <color name="surface">#FFFFFF</color>

    <!-- 输入框 / 选中区域 / 特殊组件 / 进度条底 -->
    <color name="surface_variant">#E9EDF2</color>

    <!-- Hover / Pressed / 选中状态 / 对话框底 -->
    <color name="surface_highlight">#DDE5EE</color>

    <!-- 主文字 / 所有 icon stroke -->
    <color name="foreground">#18202A</color>

    <!-- 次级文字 / 单位 / 限速 / 副标题 -->
    <color name="foreground_secondary">#5F6B78</color>

    <!-- 辅助文字 / 选中主色 -->
    <color name="foreground_tertiary">#8994A0</color>

    <!-- 分割线 / 边框 / 描边 -->
    <color name="divider">#D7DDE4</color>

    <!-- 红绿灯（固定视觉语言，不随日/夜切换） -->
    <color name="trafficRed">#FFFF5252</color>
    <color name="trafficYellow">#FFFFD740</color>
    <color name="trafficGreen">#FF69F0AE</color>

</resources>